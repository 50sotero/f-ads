# Shared by api/info.py (signs download links) and /api/download (checks them).
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# Password for /admin (the failure log) and for the JSON export at
# /api/admin/failures (send it as "Authorization: Bearer <token>").
ADMIN_TOKEN=

# Failure store: Upstash Redis REST credentials. Connecting "Upstash for Redis"
# in Vercel's Storage tab sets KV_REST_API_URL / KV_REST_API_TOKEN for you;
# the UPSTASH_REDIS_REST_* names from the Upstash console work too.
# Leave empty to only log failures to the function logs.
KV_REST_API_URL=
KV_REST_API_TOKEN=
